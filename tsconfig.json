{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "moduleResolution": "node",
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "removeComments": true,
    "sourceMap": true,
    "noImplicitAny": true,
    "target": "ES2020",
    "module": "CommonJS",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["jest"]
  },
  "include": ["src/**/*.ts", "tests/**/*.test.ts"],
  "exclude": [
    "node_modules/**/*",
    ".webpack/**/*",
    ".vscode/**/*"
  ],
}
